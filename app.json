{
  "expo": {
    "name": "Kronos & Aura",
    "slug": "kronos-aura",
    "scheme": "kronosaura",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "android": {
      "package": "com.kronosaura.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D12"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kronosaura.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5FD6B4"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
